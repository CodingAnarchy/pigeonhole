{
  "title": "Pigeonhole",
  "uid": "pigeonhole",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "description": "A starter dashboard for pigeonhole-otel's metrics (D316). See docs/guide/observability.md.",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "pigeonhole"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source"
      },
      {
        "name": "db",
        "type": "query",
        "label": "Database",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(pigeonhole_commits_total, pigeonhole_db_name)",
          "refId": "db"
        },
        "includeAll": true,
        "multi": true,
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Failed",
      "description": "1 once the instance has failed: set an alert on this first.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pigeonhole_failed_ratio{pigeonhole_db_name=~\"$db\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Recovery gave up",
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(pigeonhole_recovery_gave_up_ratio{pigeonhole_db_name=~\"$db\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Recoveries (1h)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(pigeonhole_recoveries_total{pigeonhole_db_name=~\"$db\"}[1h]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "File size",
      "description": "",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pigeonhole_file_size_bytes{pigeonhole_db_name=~\"$db\"})"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Commits by durability",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pigeonhole_durability) (rate(pigeonhole_commits_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "{{pigeonhole_durability}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Engine-side commit latency (p99)",
      "description": "Submission to resolution on the shard; excludes the caller's wake-up and the visibility wait.",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pigeonhole_durability) (pigeonhole_commit_engine_latency_seconds{pigeonhole_db_name=~\"$db\",pigeonhole_quantile=\"0.99\"})",
          "legendFormat": "{{pigeonhole_durability}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Write stall fraction",
      "description": "pacing: compaction is behind. room: the memtable arena is too small.",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pigeonhole_stall_reason) (rate(pigeonhole_write_stall_time_seconds_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "{{pigeonhole_stall_reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "L0 SSTs (compaction debt)",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pigeonhole_sst_count{pigeonhole_db_name=~\"$db\",pigeonhole_level=\"0\"})",
          "legendFormat": "L0"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Block cache hit ratio",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pigeonhole_block_cache_requests_total{pigeonhole_db_name=~\"$db\",pigeonhole_cache_result=\"hit\"}[$__rate_interval])) / sum(rate(pigeonhole_block_cache_requests_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "block cache"
        },
        {
          "refId": "B",
          "expr": "sum(rate(pigeonhole_row_cache_requests_total{pigeonhole_db_name=~\"$db\",pigeonhole_cache_result=\"hit\"}[$__rate_interval])) / sum(rate(pigeonhole_row_cache_requests_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "row cache"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Block cache pinned vs capacity",
      "description": "Past half the capacity, a cold read costs two reads.",
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pigeonhole_block_cache_pinned_bytes{pigeonhole_db_name=~\"$db\"})",
          "legendFormat": "pinned"
        },
        {
          "refId": "B",
          "expr": "sum(pigeonhole_block_cache_capacity_bytes{pigeonhole_db_name=~\"$db\"})",
          "legendFormat": "capacity"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Flushes and compactions",
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pigeonhole_outcome) (rate(pigeonhole_flushes_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "flush {{pigeonhole_outcome}}"
        },
        {
          "refId": "B",
          "expr": "sum by (pigeonhole_outcome) (rate(pigeonhole_compactions_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "compaction {{pigeonhole_outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Shard work",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(pigeonhole_shard_busy_time_seconds_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "shards' worth of work"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Change feed retention",
      "description": "Near the limit, slow subscribers start expiring.",
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pigeonhole_feed_retained_size_bytes{pigeonhole_db_name=~\"$db\"})",
          "legendFormat": "retained"
        },
        {
          "refId": "B",
          "expr": "sum(pigeonhole_feed_retained_limit_bytes{pigeonhole_db_name=~\"$db\"})",
          "legendFormat": "limit"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Transactions",
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pigeonhole_outcome) (rate(pigeonhole_transactions_total{pigeonhole_db_name=~\"$db\"}[$__rate_interval]))",
          "legendFormat": "{{pigeonhole_outcome}}"
        }
      ]
    }
  ]
}
